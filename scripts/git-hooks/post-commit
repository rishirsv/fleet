#!/bin/sh
set -eu
[ "${FLEET_SYNC_ACTIVE:-}" != 1 ] || exit 0
root=$(git rev-parse --show-toplevel)
# Rebase creates intermediate commits; publish only completed user commits.
if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
  exit 0
fi
exec python3 "$root/scripts/sync-fleet.py" --after-commit
