{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pstack",
  "version": "0.2.272",
  "description": "Focused skills for decisions, review, publishing, and workflow improvement.",
  "author": {
    "name": "Rishi"
  },
  "keywords": [
    "development",
    "workflow",
    "skills"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "pstack",
        "shortDescription": "Focused development tools",
        "longDescription": "Focused operations for decisions, independent review, publishing, and evidence-grounded workflow improvement.",
        "developerName": "Rishi",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": "Use the focused pstack skill that fits this request.",
        "brandColor": "#FF4B0A",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png",
        "screenshots": [],
        "composerIconDark": "./assets/icon.png",
        "logoDark": "./assets/logo.png"
      }
    }
  }
}
