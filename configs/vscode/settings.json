{
  "editor.fontFamily": "'Paper Mono', monospace",
  "editor.fontSize": 16,
  "terminal.integrated.fontFamily": "'Paper Mono'",
  "terminal.integrated.fontSize": 16,
  "window.autoDetectColorScheme": true,
  "chat.tools.global.autoApprove": true,
  "workbench.panel.defaultLocation": "right",
  "chat.permissions.default": "autoApprove",
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.stickyScroll.enabled": false,
  "workbench.statusBar.visible": false,
  "workbench.activityBar.location": "hidden",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "right",
  "chat.disableAIFeatures": true,
  "editor.inlineSuggest.fontFamily": "'Paper Mono', monospace",
  "editor.inlayHints.fontFamily": "'Paper Mono', monospace",
  "scm.inputFontFamily": "default",
  "debug.console.fontFamily": "'Paper Mono', monospace",
  "debug.console.fontSize": 16,
  "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
  "markdown.preview.fontSize": 16,
  "notebook.markup.fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
  "notebook.markup.fontSize": 16,
  "notebook.output.fontFamily": "'Paper Mono', monospace",
  "notebook.output.fontSize": 16,
  "chat.fontFamily": "default",
  "chat.editor.fontFamily": "'Paper Mono', monospace",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Light Modern",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "foreground": "#ededed",
      "focusBorder": "#006efe",
      "editor.background": "#000000",
      "editor.foreground": "#ededed",
      "sideBar.background": "#000000",
      "sideBar.foreground": "#ededed",
      "sideBarSectionHeader.background": "#0d0d0d",
      "panel.background": "#000000",
      "panel.border": "#262626",
      "titleBar.activeBackground": "#0d0d0d",
      "titleBar.inactiveBackground": "#0d0d0d",
      "titleBar.activeForeground": "#ededed",
      "editorGroupHeader.tabsBackground": "#000000",
      "tab.activeBackground": "#171717",
      "tab.inactiveBackground": "#000000",
      "tab.activeForeground": "#ededed",
      "tab.activeBorderTop": "#006efe",
      "terminal.background": "#000000",
      "terminal.foreground": "#ededed",
      "input.background": "#171717",
      "input.foreground": "#ededed",
      "input.border": "#262626",
      "dropdown.background": "#171717",
      "dropdown.foreground": "#ededed",
      "button.background": "#006efe",
      "button.foreground": "#ffffff",
      "textLink.foreground": "#006efe",
      "progressBar.background": "#006efe",
      "list.activeSelectionBackground": "#006efe",
      "list.activeSelectionForeground": "#ffffff",
      "list.hoverBackground": "#171717",
      "editor.selectionBackground": "#006efe55",
      "gitDecoration.addedResourceForeground": "#00ad3a",
